{
  "name": "petpass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "verify:tour-live": "node --conditions=react-server --import tsx scripts/verify-tour-live.ts",
    "verify:kakao-live": "node --conditions=react-server --import tsx scripts/verify-kakao-live.ts",
    "verify:pet-access-live": "node --conditions=react-server --import tsx scripts/verify-pet-access-live.ts",
    "diagnose:tour-service2-live": "node --conditions=react-server --import tsx scripts/diagnose-tour-service2-live.ts",
    "audit:tourism-pagination": "node --conditions=react-server --import tsx scripts/audit-tourism-pagination.ts",
    "audit:tourism-details": "node --conditions=react-server --import tsx scripts/audit-tourism-details.ts",
    "audit:kakao-candidates": "node --conditions=react-server --import tsx scripts/audit-kakao-candidates.ts",
    "verify:pet-access-samples-live": "node --conditions=react-server --import tsx scripts/find-live-pet-access-samples.ts",
    "verify:localdata-live": "node --conditions=react-server --import tsx scripts/verify-localdata-live.ts",
    "verify:accommodation-live": "node --conditions=react-server --import tsx scripts/verify-accommodation-localdata-live.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
